# Neon pooled connection (runtime queries via PrismaPg adapter)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.us-east-2.aws.neon.tech/solo_kanban?sslmode=require"

# Neon direct connection (migrations, prisma CLI)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/solo_kanban?sslmode=require"

# Public REST API (/api/v1, docs at /api/docs). Comma-separated keys of at
# least 32 characters; leave empty to disable the API. Generate one with:
#   openssl rand -hex 32
API_KEYS=""

# Google sign-in (Auth.js). See README "Google sign-in".
# Random secret that signs session cookies: openssl rand -base64 32
AUTH_SECRET=""
# OAuth client from Google Cloud Console (APIs & Services > Credentials).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Google accounts allowed to sign in (comma-separated). Empty = nobody.
ALLOWED_EMAILS=""
# Needed when hosted behind a proxy such as Amplify; harmless locally.
AUTH_TRUST_HOST="true"
# The site's public URL. Required on Amplify, where the server otherwise sees
# itself as localhost:3000. Leave unset locally.
# AUTH_URL="https://kanban.example.com"
