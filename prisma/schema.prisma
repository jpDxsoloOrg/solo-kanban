generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  epics       Epic[]
  issues      Issue[]
  sprints     Sprint[]
}

model Epic {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#6366f1") // indigo-500, for board labels
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues      Issue[]

  @@index([projectId])
}

// A time-boxed iteration. A project has at most one ACTIVE sprint (enforced in
// sprint-actions). The board shows the active sprint; completing it archives
// its DONE issues with it and moves unfinished issues elsewhere.
model Sprint {
  id          String       @id @default(cuid())
  number      Int          // per-project sequence used for default names
  name        String
  goal        String?
  status      SprintStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?    // planned end date
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues      Issue[]

  @@unique([projectId, number])
  @@index([projectId, status])
}

model Issue {
  id          String        @id @default(cuid())
  number      Int
  title       String
  description String?       // markdown content
  status      IssueStatus   @default(OPEN)
  priority    IssuePriority @default(MEDIUM)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  epicId      String?
  epic        Epic?         @relation(fields: [epicId], references: [id], onDelete: SetNull)

  // null = backlog. `order` is scoped to (projectId, sprintId, status).
  sprintId    String?
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  subtasks    Subtask[]
  comments    Comment[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([epicId])
  @@index([sprintId, status])
}

model Subtask {
  id          String   @id @default(cuid())
  title       String
  completed   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// Markdown comment on an issue. Threads are one level deep: a top-level
// comment (parentId = null) can have replies, replies cannot have replies.
model Comment {
  id        String    @id @default(cuid())
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  issueId   String
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([issueId, createdAt])
  @@index([parentId])
}
